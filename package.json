{
	"name": "favicon-fetch",
	"version": "1.0.0",
	"description": "Universal favicon fetcher with smart fallback chain. One call, best icon, works everywhere — Node.js, Deno, Bun, Cloudflare Workers.",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"files": ["dist", "!dist/*.map"],
	"sideEffects": false,
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"check": "biome check src/",
		"format": "biome check --write src/",
		"test": "vitest run",
		"test:watch": "vitest",
		"prepublishOnly": "npm run build"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.0",
		"tsup": "^8.0.0",
		"typescript": "^5.7.0",
		"vitest": "^3.0.0"
	},
	"keywords": [
		"favicon",
		"icon",
		"website-icon",
		"logo",
		"fetch",
		"scraper",
		"edge",
		"cloudflare-workers",
		"meta-tags",
		"open-graph",
		"web-manifest",
		"apple-touch-icon",
		"zero-dependency"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mulkatz/favicon-fetch.git"
	},
	"bugs": {
		"url": "https://github.com/mulkatz/favicon-fetch/issues"
	},
	"author": "Franz Benthin",
	"homepage": "https://favicon-fetch.mulkatz.dev"
}
